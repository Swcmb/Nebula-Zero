[Unit]
Description=Nebula-Zero 开户审核机器人
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
***REMOVED*** 配置与脚本同目录，改配置不用动脚本本体
ExecStart=/usr/bin/python3 /root/.nebula-zero/bot.py --config /root/.nebula-zero/bot.env
Restart=always
RestartSec=15
***REMOVED*** 机器人会处理"关闭 issue"这类不可逆动作，给足缓冲避免反复重启造成半途状态
TimeoutStopSec=30

***REMOVED*** ---- 安全加固：除了读配置与投递 QQ，不该碰到别的东西 ----
User=root
Group=root

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
***REMOVED*** 必须是 read-only 而不是 yes：ProtectHome=yes 会把 /home 整个设为不可访问，
***REMOVED*** 此时下方的 ReadWritePaths 无法为其子目录开口子，QQNotify 写 jobs.json 会失败。
ProtectHome=read-only
ReadWritePaths=/root/.nebula-zero
***REMOVED*** QQ 通知走 Hermes 的 cron 投递通道：机器人往 jobs.json 追加一次性任务，
***REMOVED*** 由 gateway 消费后推送到 QQ。该目录必须可写，否则 QQNotify.send() 会静默失败。
ReadWritePaths=/home/admin/.hermes/cron
***REMOVED*** 出网只需要这几个
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

***REMOVED*** 日志走 journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nebula-review-bot

[Install]
WantedBy=multi-user.target